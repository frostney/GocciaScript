    'targets' + DirectorySeparator + ATarget;
end;

function RemoveCompiledArtifacts(const ADirectory: string): Integer; forward;

const
  COMPILER_STAMP = 'compiler-identity.txt';

var
  GCompilerIdentity: string = '';

{ The selected compiler's build identity and date (fpc -iWD, such as
  "3.3.1+7 2026/11/24"), read once. FPC writes the same unit version for
  every build of one release, so it reuses units another build of it made. }
function CompilerIdentity: string;
begin
  if GCompilerIdentity = '' then
  begin
    if not RunCommand('fpc', ['-iWD'], GCompilerIdentity, [poRunIdle]) then
      GCompilerIdentity := '';
    GCompilerIdentity := Trim(GCompilerIdentity);
    if GCompilerIdentity = '' then
      GCompilerIdentity := 'unknown';
  end;
  Result := GCompilerIdentity;
end;

{ Stamps are read and written while test-build workers start compilers. FPC's
  TProcess hands the child every open descriptor (it closes none, and the RTL
  opens files without O_CLOEXEC), and on Unix a TFileStream holds an flock on
  its descriptor, so a stamp open at that moment stays locked for the whole
  compile. TStrings.SaveToFile locks exclusively (fmCreate), which such a
  leaked descriptor of the same stamp refuses with EAGAIN; shared locks
  (fmShareDenyNone) never refuse one another. }
const
  STAMP_SHARE = fmShareDenyNone;

function ReadStamp(const APath: string): string;
var
  Stream: TFileStream;
  Stamp: TStringList;
begin
  Stamp := TStringList.Create;
  try
    Stream := TFileStream.Create(APath, fmOpenRead or STAMP_SHARE);
    try
      Stamp.LoadFromStream(Stream);
    finally
      Stream.Free;
    end;
    Result := Trim(Stamp.Text);
  finally
    Stamp.Free;
  end;
end;

procedure WriteStamp(const APath, AText: string);
var
  Stream: TFileStream;
  Stamp: TStringList;
begin
  Stamp := TStringList.Create;
  try
    Stamp.Text := AText;
    Stream := TFileStream.Create(APath, fmCreate or STAMP_SHARE);
    try
      Stamp.SaveToStream(Stream);
    finally
      Stream.Free;
    end;
  finally
    Stamp.Free;
  end;
end;

{ Creates ADirectory when missing. A directory whose units another compiler
  build made, or that has no stamp, is emptied first: a switch between two
  builds of one FPC release (3.3.1+6 to 3.3.1+7) otherwise links the old
  build's objects, miscompiles and all. }
function EnsureUnitOutputDirectory(const ADirectory: string): string;
var
  StampPath, Previous: string;
begin
  if not DirectoryExists(ADirectory) then
    ForceDirectories(ADirectory);
  StampPath := IncludeTrailingPathDelimiter(ADirectory) + COMPILER_STAMP;
  Previous := '';
  if FileExists(StampPath) then
    Previous := ReadStamp(StampPath);
    if Previous <> CompilerIdentity then
  begin
    if RemoveCompiledArtifacts(ADirectory) > 0 then
      if Previous = '' then
        WriteLn('No compiler stamp in ', ADirectory, ': compiling its units again with ', CompilerIdentity)
      else
        WriteLn('Units in ', ADirectory, ' were made by FPC ', Previous, ': compiling them again with ',
          CompilerIdentity);
    WriteStamp(StampPath, CompilerIdentity);
  end;
  Result := ADirectory;
end;

function HasStaleArtifactSignature(const AOutput: string): Boolean;
var
  LowerOutput: string;
begin
  LowerOutput := LowerCase(AOutput);
  Result :=
    (Pos('internal error', LowerOutput) > 0) or
    (Pos('compilation raised exception internally', LowerOutput) > 0) or
    (Pos('error while compiling resources', LowerOutput) > 0) or
    ((Pos('.reslst', LowerOutput) > 0) and
     ((Pos('cannot open', LowerOutput) > 0) or
      (Pos('not found', LowerOutput) > 0) or
      (Pos('no such file', LowerOutput) > 0)));
end;

{ Deletes the compiled state FPC leaves under ADirectory (units, objects,
  resources) and returns how many files it removed. Both scoped --clean and
  the stale-state retry pass one target or test program's unit directory. }
function RemoveCompiledArtifacts(const ADirectory: string): Integer;
var
  Files: TStringList;
  K: Integer;
begin
  Files := TStringList.Create;
  try
    AddFoundFiles(Files, ADirectory, '.ppu');
    AddFoundFiles(Files, ADirectory, '.o');
    AddFoundFiles(Files, ADirectory, '.or');
    AddFoundFiles(Files, ADirectory, '.res');
    AddFoundFiles(Files, ADirectory, '.reslst');

    for K := 0 to Files.Count - 1 do
      DeleteFile(Files[K]);

    Result := Files.Count;
  finally
    Files.Free;
  end;
end;

{ Runs fpc for ASource into AUnitOutputDirectory. When it fails with a
  stale-compiled-state symptom, wipes that one unit directory and runs the
  compile once more, as --clean would for it. A failure without such a symptom
  (an ordinary compile error) is returned as is, and the retry is never
  repeated: AOutput holds the output of the last run. ALabel names the thing
  being built in the message. }
function CompileWithStaleRetry(const ASource, AUnitOutputDirectory,
  ALabel: string; out AOutput: string): Boolean;
begin
  Result := CompileProgram(FPCArgs(ASource,
    EnsureUnitOutputDirectory(AUnitOutputDirectory)), AOutput);
  if Result or not HasStaleArtifactSignature(AOutput) then
    Exit;

  WriteLn('FPC reported a stale-state error for ', ALabel,
    '; retrying once from a clean unit directory. The first attempt:');
  { what the first attempt said: a retry that fails as well shows only its own output }
  WriteLn(AOutput);
  RemoveCompiledArtifacts(AUnitOutputDirectory);
  Result := CompileProgram(FPCArgs(ASource,
    EnsureUnitOutputDirectory(AUnitOutputDirectory)), AOutput);
end;

procedure PrintBuildFailureAndExit(const AOutput, AFailureMessage: string);
begin
  WriteLn(AOutput);
  if HasStaleArtifactSignature(AOutput) then
  begin
    WriteLn('');
    WriteLn('Hint: this looked like stale FPC build state, but the build ' +
      'already retried once from a clean unit directory and failed again.');
    WriteLn('Diagnose the reported source line.');
    WriteLn('');
  end;
  WriteLn(AFailureMessage);
  Halt(1);
end;

{ ---- Engine ---- }

function GocciaGeneratedDirectory: string;
begin
  Result := 'build' + DirectorySeparator + 'engine' + DirectorySeparator + 'gen';
end;

{ Writes AText to AFile unless it already holds it; True when it changed }
function WriteIfChanged(const AFile, AText: string): Boolean;
var
  Old: TStringList;
  Lines: TStringList;
begin
  Result := True;
  if FileExists(AFile) then
  begin
    Old := TStringList.Create;
    try
      Old.LoadFromFile(AFile);
      Result := Old.Text <> AText;
    finally
      Old.Free;
    end;
  end;
  if not Result then
    Exit;
  Lines := TStringList.Create;
  try
    Lines.Text := AText;
    Lines.SaveToFile(AFile);
  finally
    Lines.Free;
  end;
end;

{ each JS prelude as a Pascal UnicodeString constant, one line each (the preludes are ASCII) }
procedure GenerateEnginePreludes;
var
  K, L, C: Integer;
  Src, Text: TStringList;
  Line, Body: string;
begin
  ForceDirectories(GocciaGeneratedDirectory);
  { scripts/engine/build.sh wrote the version include here, ahead of the one build.pas writes into source/units }
  DeleteFile(GocciaGeneratedDirectory + DirectorySeparator + 'Goccia.Version.Generated.inc');
  for K := 0 to High(GOCCIA_PRELUDES) do
  begin
    Src := TStringList.Create;
    try
      Src.LoadFromFile('source/engine/prelude/' + GOCCIA_PRELUDES[K, 0]);
      while (Src.Count > 0) and (Src[Src.Count - 1] = '') do
        Src.Delete(Src.Count - 1);
      Body := '';
      for L := 0 to Src.Count - 1 do
      begin
        Line := Src[L];
        for C := 1 to Length(Line) do
          if Ord(Line[C]) > 127 then
          begin
            WriteLn('Non-ASCII character in prelude ', GOCCIA_PRELUDES[K, 0], ' line ', L + 1);
            Halt(1);
          end;
        if L > 0 then
          Body := Body + ' +' + LineEnding;
        Body := Body + '    ''' + StringReplace(Line, '''', '''''', [rfReplaceAll]) + '''#10';
      end;
      Text := TStringList.Create;
      try
        Text.Add('{ generated by build.pas from ' + GOCCIA_PRELUDES[K, 0] + ' }');
        Text.Add('const');
        Text.Add('  ' + GOCCIA_PRELUDES[K, 2] + ' =');
        Text.Add(Body + ';');
        WriteIfChanged(GocciaGeneratedDirectory + DirectorySeparator + GOCCIA_PRELUDES[K, 1], Text.Text);
      finally
        Text.Free;
      end;
    finally
      Src.Free;
    end;
  end;
end;

{ Each engine program's own prelude snapshot: a program that installs the host's preludes (the apps) compiles more of
  them than the bare engine (goccia), so they cannot share one }
function GocciaSnapshotDirectory(const ATarget: string): string;
begin
  Result := 'build' + DirectorySeparator + 'engine' + DirectorySeparator + 'snapshot-' + ATarget;
end;

{ an empty snapshot until the program has made one }
procedure EnsureEngineSnapshot(const ATarget: string);
begin
  ForceDirectories(GocciaSnapshotDirectory(ATarget));
  if not FileExists(GocciaSnapshotDirectory(ATarget) + DirectorySeparator + 'Goccia.PreludeSnapshot.inc') then
    WriteIfChanged(GocciaSnapshotDirectory(ATarget) + DirectorySeparator + 'Goccia.PreludeSnapshot.inc',
      'const' + LineEnding + '  GocciaPreludeSnapshotSize = 0;' + LineEnding +
      '  GocciaPreludeSnapshot: array[0..0] of Byte = (0);' + LineEnding);
end;

{ The compiler arguments of an engine program. The engine always compiles optimized: its code
  is not written for the dev build's range, overflow and assertion checks. A
  dev build keeps line information instead of stripping it. }
{ FPC_TARGET_CPU and FPC_TARGET_OS name another platform than the one build.pas runs on: an engine program is then
  built for the host first, to make its prelude snapshot (which does not depend on the platform), then for the
  target with it }
function GocciaCrossBuild: Boolean;
var
  Cpu, OS: string;
begin
  Cpu := LowerCase(GetEnvironmentVariable('FPC_TARGET_CPU'));
  OS := LowerCase(GetEnvironmentVariable('FPC_TARGET_OS'));
  Result := ((Cpu <> '') and (Cpu <> LowerCase({$I %FPCTARGETCPU%}))) or
    ((OS <> '') and (OS <> LowerCase({$I %FPCTARGETOS%})));
end;

{ AOutput with .exe when the build (the host's when AHost) makes a Windows executable }
function GocciaExecutable(const AOutput: string; AHost: Boolean): string;
var
  OS: string;
begin
  OS := LowerCase(GetEnvironmentVariable('FPC_TARGET_OS'));
  if AHost or (OS = '') then
    OS := LowerCase({$I %FPCTARGETOS%});
  Result := AOutput;
  if ((OS = 'win32') or (OS = 'win64')) and (ExtractFileExt(Result) = '') then
    Result := Result + '.exe';
end;

{ AHost: the host build of a cross build (no target options, no GOCCIA_FPC_FLAGS) }
function GocciaArgs(const ASource, AUnitDirectory, AOutput, ATarget: string; AHost: Boolean = False): TStringArray;
var
  Args: TStringList;
  Extra, Word, Cpu: string;
  J: Integer;
begin
  Args := TStringList.Create;
  try
    if not AHost then
    begin
      if GetEnvironmentVariable('FPC_TARGET_CPU') <> '' then
        Args.Add('-P' + GetEnvironmentVariable('FPC_TARGET_CPU'));
      if GetEnvironmentVariable('FPC_TARGET_OS') <> '' then
        Args.Add('-T' + GetEnvironmentVariable('FPC_TARGET_OS'));
    end;
    { i386 (win32): -O1. FPC 3.3.1's -O3 and -O4 address an inlined field read through a register they never
      loaded in Goccia.VM's iterator step (an access violation on every typed array iteration), and with -O2 a
      describe.each inside a describe throws a TypeError that -O1 does not (the miscompile not yet isolated) }
    Cpu := LowerCase(GetEnvironmentVariable('FPC_TARGET_CPU'));
    if AHost or (Cpu = '') then
      Cpu := LowerCase({$I %FPCTARGETCPU%});
    if Cpu = 'i386' then
      Args.Add('-O1')
    else
      Args.Add('-O4');
    Args.Add('-OoNOFASTMATH');
    Args.Add('-dPRODUCTION');
    if BuildMode = bmProd then
      Args.Add('-Xs')
    else
      Args.Add('-gl');
    Args.Add('-Fusource/engine');
    Args.Add('-Fusource/units');
    Args.Add('-Fusource/shared');
    Args.Add('-Fusource/generated');
    Args.Add('-Fusource/app');
    Args.Add('-Fi' + GocciaSnapshotDirectory(ATarget));
    Args.Add('-Fi' + GocciaGeneratedDirectory);
    Args.Add('-Fisource/engine');
    Args.Add('-Fisource/units');
    Args.Add('-Fisource/shared');
    Args.Add('-Fisource/generated');
    Args.Add('-Fisource/app');
    Args.Add('-Fisource');
    Args.Add('-FU' + AUnitDirectory);
    Args.Add('-o' + AOutput);
    Args.Add('-vw-n-h-i-l-d-u-t-p-c-x-');
    { the target's library options (CI's link libraries and SDK paths) and a variant's own flags, space-separated:
      after the defaults, so that an -O- or -g of its own replaces theirs (FPC takes an option's last value) }
    if not AHost then
    begin
      Extra := GetEnvironmentVariable('GOCCIA_FPC_FLAGS') + ' ';
      Word := '';
      for J := 1 to Length(Extra) do
        if Extra[J] = ' ' then
        begin
          if Word <> '' then
            Args.Add(Word);
          Word := '';
        end
        else
          Word := Word + Extra[J];
    end;
    Args.Add(ASource);
    SetLength(Result, Args.Count);
    for J := 0 to Args.Count - 1 do
      Result[J] := Args[J];
  finally
    Args.Free;
  end;
end;

{ Copies the compiled resources the units link (source/generated/*.res) into AUnitDirectory }
procedure CopyEngineResources(const AUnitDirectory: string);
var
  Res: TStringList;
  Source, Target: TFileStream;
  K: Integer;
begin
  EnsureUnitOutputDirectory(AUnitDirectory);
  Res := TStringList.Create;
  try
    AddFoundFiles(Res, 'source' + DirectorySeparator + 'generated', '.res');
    for K := 0 to Res.Count - 1 do
      if not FileExists(AUnitDirectory + DirectorySeparator + ExtractFileName(Res[K])) then
      begin
        Source := TFileStream.Create(Res[K], fmOpenRead or fmShareDenyWrite);
        try
          Target := TFileStream.Create(AUnitDirectory + DirectorySeparator + ExtractFileName(Res[K]), fmCreate);
          try
            Target.CopyFrom(Source, 0);
          finally
            Target.Free;
          end;
        finally
          Source.Free;
        end;
      end;
  finally
    Res.Free;
  end;
end;

{ As CompileWithStaleRetry, with an engine program's arguments }
function CompileEngineProgram(const ASource, AUnitDirectory, AOutput, ALabel: string;
  out AOutputText: string; AHost: Boolean = False): Boolean;
begin
  CopyEngineResources(AUnitDirectory);
  Result := CompileProgram(GocciaArgs(ASource, AUnitDirectory, AOutput, ALabel, AHost), AOutputText);
  if Result or not HasStaleArtifactSignature(AOutputText) then
    Exit;
  WriteLn('FPC reported a stale-state error for ', ALabel, '; retrying once from a clean unit directory. The first attempt:');
  { what the first attempt said: a retry that fails as well shows only its own output }
  WriteLn(AOutputText);
  RemoveCompiledArtifacts(AUnitDirectory);
  CopyEngineResources(AUnitDirectory);
  Result := CompileProgram(GocciaArgs(ASource, AUnitDirectory, AOutput, ALabel, AHost), AOutputText);
end;

{ Runs the stage-1 engine to snapshot its compiled preludes (Goccia.Snapshot) into Goccia.PreludeSnapshot.inc; True when
  the snapshot changed, so the engine is compiled again with it }
function SnapshotEnginePreludes(const AExecutable, ATarget: string): Boolean;
var
  Proc: TProcess;
  Snap, Empty: string;
  F: TFileStream;
  Bytes: array of Byte;
  Text: TStringBuilder;
  K: Integer;
begin
  Snap := 'build' + DirectorySeparator + 'engine' + DirectorySeparator + 'snap.bin';
  Empty := 'build' + DirectorySeparator + 'engine' + DirectorySeparator + 'snap-empty.js';
  WriteIfChanged(Empty, 'const x = 0;' + LineEnding);
  { the benchmark runner fails a file without benchmarks: its run measures one, as briefly as the settings allow }
  if ATarget = 'benchmarkrunner' then
  begin
    Empty := 'build' + DirectorySeparator + 'engine' + DirectorySeparator + 'snap-bench.js';
    WriteIfChanged(Empty, 'import { bench } from "goccia:microbench";' + LineEnding +
      'bench("snapshot", () => 0);' + LineEnding);
  end;
  Proc := TProcess.Create(nil);
  try
    Proc.Executable := AExecutable;
    Proc.Parameters.Add(Empty);
    for K := 0 to GetEnvironmentVariableCount - 1 do
      Proc.Environment.Add(GetEnvironmentString(K));
    Proc.Environment.Add('GOCCIA_SNAPSHOT_OUT=' + Snap);
    if ATarget = 'benchmarkrunner' then
    begin
      Proc.Parameters.Add('--no-progress');
      Proc.Environment.Add('GOCCIA_BENCH_WARMUP=1');
      Proc.Environment.Add('GOCCIA_BENCH_CALIBRATION_MS=1');
      Proc.Environment.Add('GOCCIA_BENCH_ROUNDS=1');
    end;
    Proc.Environment.Add('GOCCIA_NO_SNAPSHOT=1');
    Proc.Options := [poWaitOnExit];
    Proc.Execute;
    if Proc.ExitStatus <> 0 then
    begin
      WriteLn('The prelude snapshot run failed (exit ', Proc.ExitStatus, ')');
      Halt(1);
    end;
  finally
    Proc.Free;
  end;
  F := TFileStream.Create(Snap, fmOpenRead);
  try
    SetLength(Bytes, F.Size);
    if F.Size > 0 then
      F.ReadBuffer(Bytes[0], F.Size);
  finally
    F.Free;
  end;
  Text := TStringBuilder.Create;
  try
    Text.Append('{ generated by build.pas from GOCCIA_SNAPSHOT_OUT: compiled JS preludes (see Goccia.Snapshot) }' + LineEnding);
    Text.Append('const' + LineEnding);
    Text.Append('  GocciaPreludeSnapshotSize = ' + IntToStr(Length(Bytes)) + ';' + LineEnding);
    Text.Append('  GocciaPreludeSnapshot: array[0..' + IntToStr(Length(Bytes) - 1) + '] of Byte = (' + LineEnding + '    ');
    for K := 0 to High(Bytes) do
    begin
      if K > 0 then
      begin
        Text.Append(',');
        if K mod 32 = 0 then
          Text.Append(LineEnding + '    ');
      end;
      Text.Append(IntToStr(Bytes[K]));
    end;
    Text.Append(');' + LineEnding);
    Result := WriteIfChanged(GocciaSnapshotDirectory(ATarget) + DirectorySeparator + 'Goccia.PreludeSnapshot.inc',
      Text.ToString);
  finally
    Text.Free;
  end;
end;

{ Linux x86-64: the native-TLS relocation check (scripts/engine/tlsscan.py), when python3 and binutils are there }
procedure CheckEngineThreadVarRelocations(const AUnitDirectory: string);
var
  Objects: TStringList;
  Args: array of string;
  Output: string;
  K: Integer;
begin
  {$IF defined(LINUX) and defined(CPUX86_64)}
  Objects := TStringList.Create;
  try
    AddFoundFiles(Objects, AUnitDirectory, '.o');
    SetLength(Args, Objects.Count + 1);
    Args[0] := 'scripts/engine/tlsscan.py';
    for K := 0 to Objects.Count - 1 do
      Args[K + 1] := Objects[K];
    if not RunCommand('python3', Args, Output) then
    begin
      WriteLn('Skipping the threadvar relocation check: python3 or binutils is missing');
      Exit;
    end;
    if Pos('total 0' + LineEnding, Output) <> 0 then
      WriteLn('Threadvar relocations: none broken')
    else
    begin
      WriteLn('Broken threadvar relocations:');
      WriteLn(Output);
      Halt(1);
    end;
  finally
    Objects.Free;
  end;
  {$ENDIF}
end;

{ Builds ASource as an engine program: the preludes generated, stage 1 compiled, its compiled preludes snapshot, and
  the program compiled again when the snapshot changed. A cross build (GocciaCrossBuild) makes the snapshot with a
  host build of the program (build/engine/host), then compiles the target once with it. }
{ GOCCIA_VARIANT names a variant build of a program, such as fuzz.yml's AFL-instrumented or heaptrc harness: it goes
  to AOutput followed by the name (build/GocciaFuzzHarnessAfl) and compiles in a unit cache of its own, since FPC
  does not recompile a unit for new options; GOCCIA_FPC_FLAGS carries its compiler options }
procedure BuildEngineProgram(const ASource, ATarget, AOutput: string);
var
  UnitDir, Output, HostOutput, TargetOutput, Variant, Program_: string;
begin
  Variant := GetEnvironmentVariable('GOCCIA_VARIANT');
  Program_ := AOutput + Variant;
  WriteLn('');
  WriteLn('Building ', Program_, '...');
  GenerateEnginePreludes;
  EnsureEngineSnapshot(ATarget);
  { its own unit cache per mode: an engine program builds incrementally (no -B), and FPC does not recompile a unit for new options }
  UnitDir := TargetUnitOutputDirectory(ATarget);
  if BuildMode <> bmProd then
    UnitDir := UnitDir + '-dev';
  if Variant <> '' then
    UnitDir := UnitDir + '-' + LowerCase(Variant);
  if GocciaCrossBuild then
  begin
    ForceDirectories('build' + DirectorySeparator + 'engine' + DirectorySeparator + 'host');
    HostOutput := GocciaExecutable('build' + DirectorySeparator + 'engine' + DirectorySeparator + 'host' +
      DirectorySeparator + ExtractFileName(Program_), True);
    if not CompileEngineProgram(ASource, UnitDir + '-host', HostOutput, ATarget, Output, True) then
      PrintBuildFailureAndExit(Output, HostOutput + ' build failed');
    SnapshotEnginePreludes(HostOutput, ATarget);
    { the target's own unit cache: units compiled for another platform }
    UnitDir := UnitDir + '-' + LowerCase(GetEnvironmentVariable('FPC_TARGET_CPU')) + '-' +
      LowerCase(GetEnvironmentVariable('FPC_TARGET_OS'));
    TargetOutput := GocciaExecutable(Program_, False);
    if not CompileEngineProgram(ASource, UnitDir, TargetOutput, ATarget, Output) then
      PrintBuildFailureAndExit(Output, TargetOutput + ' build failed');
    WriteLn(TargetOutput, ' built successfully');
    Exit;
  end;
  if not CompileEngineProgram(ASource, UnitDir, Program_, ATarget, Output) then
  begin
    { a broken threadvar reference can be why the link failed (ld refuses a TLS mismatch): named first }
    CheckEngineThreadVarRelocations(UnitDir);
    PrintBuildFailureAndExit(Output, Program_ + ' build failed');
  end;
  CheckEngineThreadVarRelocations(UnitDir);
  if SnapshotEnginePreludes(Program_, ATarget) then
  begin
    WriteLn('Prelude snapshot changed: compiling again with it');
    DeleteFile(UnitDir + DirectorySeparator + 'Goccia.Snapshot.ppu');
    DeleteFile(UnitDir + DirectorySeparator + 'Goccia.Snapshot.o');
    if not CompileEngineProgram(ASource, UnitDir, Program_, ATarget, Output) then
    begin
      CheckEngineThreadVarRelocations(UnitDir);
      PrintBuildFailureAndExit(Output, Program_ + ' build failed');
    end;
    CheckEngineThreadVarRelocations(UnitDir);
  end;
  WriteLn(Program_, ' built successfully');
end;

{ native-TLS threadvars and the code generator fixes the engine needs are in fpc-toolchain's 3.3.1 builds }
procedure CheckEngineCompiler;
var
  Version: string;
