end;

procedure StripBlockComments(var AText: string; var AInBlock: Boolean);
var
  OpenPos, ClosePos: SizeInt;
  Sub: string;
begin
  repeat
    if AInBlock then
    begin
      ClosePos := Pos('}', AText);
      if ClosePos = 0 then
        ClosePos := Pos('*)', AText);
      if ClosePos > 0 then
      begin
        if AText[ClosePos] = '*' then
          Delete(AText, 1, ClosePos + 1)
        else
          Delete(AText, 1, ClosePos);
        AText := Trim(AText);
        AInBlock := False;
      end
      else
      begin
        AText := '';
        Exit;
      end;
    end
    else
    begin
      OpenPos := Pos('{', AText);
      if (OpenPos > 0) and (Copy(AText, OpenPos, 2) <> '{$') then
      begin
        Sub := Copy(AText, OpenPos + 1, Length(AText));
        ClosePos := Pos('}', Sub);
        if ClosePos > 0 then
        begin
          Delete(AText, OpenPos, ClosePos + 1);
          AText := Trim(AText);
        end
        else
        begin
          Delete(AText, OpenPos, Length(AText));
          AText := Trim(AText);
          AInBlock := True;
          Exit;
        end;
        Continue;
      end;

      OpenPos := Pos('(*', AText);
      if OpenPos > 0 then
      begin
        Sub := Copy(AText, OpenPos + 2, Length(AText));
        ClosePos := Pos('*)', Sub);
        if ClosePos > 0 then
        begin
          Delete(AText, OpenPos, ClosePos + 3);
          AText := Trim(AText);
        end
        else
        begin
          Delete(AText, OpenPos, Length(AText));
          AText := Trim(AText);
          AInBlock := True;
          Exit;
        end;
        Continue;
      end;

      Exit;
    end;
  until AText = '';
end;

procedure CountLines(const AFileName: string; out ALOC, ASLOC: Integer);
var
  F: TextFile;
  Line, Trimmed: string;
  InBlock: Boolean;
begin
  ALOC := 0;
  ASLOC := 0;
  InBlock := False;

  AssignFile(F, AFileName);
  Reset(F);
  try
    while not EOF(F) do
    begin
      ReadLn(F, Line);
      Inc(ALOC);
      Trimmed := Trim(Line);

      StripBlockComments(Trimmed, InBlock);

      if Trimmed = '' then
        Continue;
      if Copy(Trimmed, 1, 2) = '//' then
        Continue;

      Inc(ASLOC);
    end;
  finally
    CloseFile(F);
  end;
end;

function FormatNumber(const AValue: Integer): string;
var
  S: string;
  Len, InsertPos: Integer;
begin
  S := IntToStr(AValue);
  Len := Length(S);
  InsertPos := Len - 3;
  while InsertPos > 0 do
  begin
    Insert(',', S, InsertPos + 1);
    Dec(InsertPos, 3);
  end;
  Result := S;
end;

{ FindAllFiles returns a list the caller owns (#1592). }
procedure AddFoundFiles(const AFiles: TStringList; const ADirectory,
  AExtension: string);
var
  Found: TStringList;
begin
  Found := FindAllFiles(ADirectory, AExtension);
  try
    AFiles.AddStrings(Found);
  finally
    Found.Free;
  end;
end;

procedure PrintSourceStats;
var
  Files: TStringList;
  K, FileLOC, FileSLOC, TotalLOC, TotalSLOC: Integer;
begin
  TotalLOC := 0;
  TotalSLOC := 0;

  Files := TStringList.Create;
  try
    AddFoundFiles(Files, 'source/units', '.pas');
    AddFoundFiles(Files, 'source/shared', '.pas');
    AddFoundFiles(Files, 'source/app', '.pas');
    AddFoundFiles(Files, 'source/app', '.dpr');
    AddFoundFiles(Files, 'source/units', '.inc');

    for K := 0 to Files.Count - 1 do
    begin
      CountLines(Files[K], FileLOC, FileSLOC);
      TotalLOC := TotalLOC + FileLOC;
      TotalSLOC := TotalSLOC + FileSLOC;
    end;

    WriteLn('Source: ', FormatNumber(TotalLOC), ' LOC | ', FormatNumber(TotalSLOC), ' SLOC (', Files.Count, ' files)');
    WriteLn('');
  finally
    Files.Free;
  end;
end;

function GCStressExecutableDirectory: string;
begin
  Result := 'build' + DirectorySeparator + 'gc-stress';
end;

function LayoutProbeExecutableDirectory: string;
begin
  Result := 'build' + DirectorySeparator + 'layout-probe';
end;

{ Root of the unit caches. The GC-stress and layout-probe builds keep their
  own, because FPC does not recompile a unit when only the defines change: a
  shared cache would hand their units to an ordinary build, or the reverse. }
function CompiledRootDirectory: string;
begin
  Result := 'build' + DirectorySeparator + 'compiled';
  if GCStressBuild then
    Result := Result + DirectorySeparator + 'gc-stress'
  else if LayoutProbeBuild then
    Result := Result + DirectorySeparator + 'layout-probe';
end;

function FPCArgs(const ASource: string;
  const AUnitOutputDirectory: string = ''): TStringArray;
var
  Arch: string;
  Args: TStringList;
  J: Integer;
begin
  Args := TStringList.Create;
  try
    Arch := GetEnvironmentVariable('FPC_TARGET_CPU');
    if Arch <> '' then
      Args.Add('-P' + Arch);

    Arch := GetEnvironmentVariable('FPC_TARGET_OS');
    if Arch <> '' then
      Args.Add('-T' + Arch);

    Args.Add('@config.cfg');
    if AUnitOutputDirectory <> '' then
      Args.Add('-FU' + AUnitOutputDirectory);

    if BuildMode = bmProd then
    begin
      // -O4 for aggressive optimization. The one -O4 optimization that is
      // unsafe for this engine, FASTMATH, is force-disabled at the source level
      // in Shared.inc ({$OPTIMIZATION NOFASTMATH}) because it violates the
      // IEEE-754 double semantics JavaScript requires (it miscompiled the
      // edge-case Temporal hoursInDay DST math — PR #797). Keeping the guard in
      // source rather than here makes it a compiler-enforced invariant that
      // travels with the code regardless of how fpc is invoked.
      Args.Add('-O4');
      Args.Add('-dPRODUCTION');
      Args.Add('-Xs');
      Args.Add('-CX');
      Args.Add('-XX');
      Args.Add('-B');
      if LayoutProbeBuild then
      begin
        Args.Add('-dGOCCIA_VM_LAYOUT_PROBE');
        Args.Add('-FE' + LayoutProbeExecutableDirectory);
      end;
    end else
    begin
      Args.Add('-O-');
      Args.Add('-gw');
      Args.Add('-godwarfsets');
      Args.Add('-gl');
      Args.Add('-Ct');
      Args.Add('-Cr');
      Args.Add('-Sa');
      if GCStressBuild then
      begin
        Args.Add('-gh');
        Args.Add('-dGOCCIA_GC_STRESS');
        Args.Add('-FE' + GCStressExecutableDirectory);
      end;
    end;

    Args.Add('-vw-n-h-i-l-d-u-t-p-c-x-');
    Args.Add(ASource);

    SetLength(Result, Args.Count);
    for J := 0 to Args.Count - 1 do
      Result[J] := Args[J];
  finally
    Args.Free;
  end;
end;

{ Query the effective compiler target, including config.cfg and cross-target
  environment overrides. The build host need not be the executable's target. }
function CompileProgram(const AArguments: TStringArray;
  out AOutput: string): Boolean;
var
  Arguments: TStringArray;
  Target, Executable, ObjectDirectory: string;
  Lines: TStringList;
  J: Integer;
begin
  Arguments := Copy(AArguments);
  SetLength(Arguments, Length(Arguments) + 1);
  Arguments[High(Arguments) - 1] := '-iTP';
  Arguments[High(Arguments)] := '-iTO';
  if not RunCommand('fpc', Arguments, Target, [poRunIdle]) then
    raise Exception.Create('Cannot determine compiler target: ' + Target);
  if Trim(Target) <> 'i386 win32' then
    Exit(RunCommand('fpc', AArguments, AOutput, [poRunIdle]));

  ObjectDirectory := '';
  for J := 0 to High(AArguments) do
    if Copy(AArguments[J], 1, 3) = '-FU' then
      ObjectDirectory := Copy(AArguments[J], 4, MaxInt);
  if ObjectDirectory = '' then
    raise Exception.Create('Win32 build requires its compiler-owned unit directory');
  SetLength(Arguments, Length(Arguments) + 1);
  // The ordinary build suppresses informational output. Retain the linker's
  // output path here so config.cfg output overrides are finalized correctly.
  Arguments[High(Arguments) - 2] := '-vi';
  Arguments[High(Arguments) - 1] := '-Xm';
  Arguments[High(Arguments)] := AArguments[High(AArguments)];
  Result := RunCommand('fpc', Arguments, AOutput, [poRunIdle]);
  if not Result then
    Exit;
  Executable := '';
  Lines := TStringList.Create;
  try
    Lines.Text := AOutput;
    for J := 0 to Lines.Count - 1 do
      if Copy(Lines[J], 1, 8) = 'Linking ' then
        Executable := Trim(Copy(Lines[J], 9, MaxInt));
    if Executable = '' then
      raise Exception.Create('Win32 build did not report its linked executable');
    FinalizeFPCExecutable(Executable, ChangeFileExt(Executable, '.map'), ObjectDirectory);
    AOutput := AOutput + LineEnding + 'SafeSEH verified: ' + Executable;
  except
    on E: Exception do
    begin
      if Executable <> '' then
        DeleteFile(Executable);
      AOutput := AOutput + LineEnding + 'SafeSEH failed: ' + E.Message;
      Result := False;
    end;
  end;
  Lines.Free;
end;

function TestUnitOutputDirectory(const ATestFile: string): string;
var
  RelativePath, SafePath: string;
begin
  RelativePath := ChangeFileExt(ATestFile, '');
  SafePath := StringReplace(RelativePath, '/', DirectorySeparator, [rfReplaceAll]);
  SafePath := StringReplace(SafePath, '\', DirectorySeparator, [rfReplaceAll]);
  Result := CompiledRootDirectory + DirectorySeparator +
    'tests' + DirectorySeparator + SafePath;
end;

function TargetUnitOutputDirectory(const ATarget: string): string;
begin
  Result := CompiledRootDirectory + DirectorySeparator +
    'targets' + DirectorySeparator + ATarget;
end;

function RemoveCompiledArtifacts(const ADirectory: string): Integer; forward;

const
  COMPILER_STAMP = 'compiler-identity.txt';

var
  GCompilerIdentity: string = '';

{ The selected compiler's build identity and date (fpc -iWD, such as
  "3.3.1+7 2026/11/24"), read once. FPC writes the same unit version for
  every build of one release, so it reuses units another build of it made. }
function CompilerIdentity: string;
begin
  if GCompilerIdentity = '' then
  begin
    if not RunCommand('fpc', ['-iWD'], GCompilerIdentity, [poRunIdle]) then
      GCompilerIdentity := '';
    GCompilerIdentity := Trim(GCompilerIdentity);
    if GCompilerIdentity = '' then
      GCompilerIdentity := 'unknown';
  end;
  Result := GCompilerIdentity;
end;

{ Creates ADirectory when missing. A directory whose units another compiler
  build made, or that has no stamp, is emptied first: a switch between two
  builds of one FPC release (3.3.1+6 to 3.3.1+7) otherwise links the old
  build's objects, miscompiles and all. }
function EnsureUnitOutputDirectory(const ADirectory: string): string;
var
  Stamp: TStringList;
  StampPath, Previous: string;
begin
  if not DirectoryExists(ADirectory) then
    ForceDirectories(ADirectory);
  StampPath := IncludeTrailingPathDelimiter(ADirectory) + COMPILER_STAMP;
  Stamp := TStringList.Create;
  try
    Previous := '';
    if FileExists(StampPath) then
    begin
      Stamp.LoadFromFile(StampPath);
      Previous := Trim(Stamp.Text);
    end;
    if Previous <> CompilerIdentity then
    begin
      if RemoveCompiledArtifacts(ADirectory) > 0 then
        if Previous = '' then
          WriteLn('No compiler stamp in ', ADirectory, ': compiling its units again with ', CompilerIdentity)
        else
          WriteLn('Units in ', ADirectory, ' were made by FPC ', Previous, ': compiling them again with ',
            CompilerIdentity);
      Stamp.Text := CompilerIdentity;
      Stamp.SaveToFile(StampPath);
    end;
  finally
    Stamp.Free;
  end;
  Result := ADirectory;
end;

function HasStaleArtifactSignature(const AOutput: string): Boolean;
var
  LowerOutput: string;
begin
  LowerOutput := LowerCase(AOutput);
  Result :=
    (Pos('internal error', LowerOutput) > 0) or
    (Pos('compilation raised exception internally', LowerOutput) > 0) or
    (Pos('error while compiling resources', LowerOutput) > 0) or
    ((Pos('.reslst', LowerOutput) > 0) and
     ((Pos('cannot open', LowerOutput) > 0) or
      (Pos('not found', LowerOutput) > 0) or
      (Pos('no such file', LowerOutput) > 0)));
end;

{ Deletes the compiled state FPC leaves under ADirectory (units, objects,
  resources) and returns how many files it removed. Both scoped --clean and
  the stale-state retry pass one target or test program's unit directory. }
function RemoveCompiledArtifacts(const ADirectory: string): Integer;
var
  Files: TStringList;
  K: Integer;
begin
  Files := TStringList.Create;
  try
    AddFoundFiles(Files, ADirectory, '.ppu');
    AddFoundFiles(Files, ADirectory, '.o');
    AddFoundFiles(Files, ADirectory, '.or');
    AddFoundFiles(Files, ADirectory, '.res');
    AddFoundFiles(Files, ADirectory, '.reslst');

    for K := 0 to Files.Count - 1 do
      DeleteFile(Files[K]);

    Result := Files.Count;
  finally
    Files.Free;
  end;
end;

{ Runs fpc for ASource into AUnitOutputDirectory. When it fails with a
  stale-compiled-state symptom, wipes that one unit directory and runs the
  compile once more, as --clean would for it. A failure without such a symptom
  (an ordinary compile error) is returned as is, and the retry is never
  repeated: AOutput holds the output of the last run. ALabel names the thing
  being built in the message. }
function CompileWithStaleRetry(const ASource, AUnitOutputDirectory,
  ALabel: string; out AOutput: string): Boolean;
begin
  Result := CompileProgram(FPCArgs(ASource,
    EnsureUnitOutputDirectory(AUnitOutputDirectory)), AOutput);
  if Result or not HasStaleArtifactSignature(AOutput) then
    Exit;

  WriteLn('FPC reported a stale-state error for ', ALabel,
    '; retrying once from a clean unit directory. The first attempt:');
  { what the first attempt said: a retry that fails as well shows only its own output }
  WriteLn(AOutput);
  RemoveCompiledArtifacts(AUnitOutputDirectory);
  Result := CompileProgram(FPCArgs(ASource,
    EnsureUnitOutputDirectory(AUnitOutputDirectory)), AOutput);
end;

procedure PrintBuildFailureAndExit(const AOutput, AFailureMessage: string);
begin
  WriteLn(AOutput);
  if HasStaleArtifactSignature(AOutput) then
  begin
    WriteLn('');
    WriteLn('Hint: this looked like stale FPC build state, but the build ' +
      'already retried once from a clean unit directory and failed again.');
    WriteLn('Diagnose the reported source line.');
    WriteLn('');
  end;
  WriteLn(AFailureMessage);
  Halt(1);
end;

{ ---- G2 ---- }

function G2GeneratedDirectory: string;
begin
  Result := 'build' + DirectorySeparator + 'g2' + DirectorySeparator + 'gen';
end;

{ Writes AText to AFile unless it already holds it; True when it changed }
function WriteIfChanged(const AFile, AText: string): Boolean;
var
  Old: TStringList;
  Lines: TStringList;
begin
  Result := True;
  if FileExists(AFile) then
  begin
    Old := TStringList.Create;
    try
      Old.LoadFromFile(AFile);
      Result := Old.Text <> AText;
    finally
      Old.Free;
    end;
  end;
  if not Result then
    Exit;
  Lines := TStringList.Create;
  try
    Lines.Text := AText;
    Lines.SaveToFile(AFile);
  finally
    Lines.Free;
  end;
end;

{ each JS prelude as a Pascal UnicodeString constant, one line each (the preludes are ASCII) }
procedure GenerateG2Preludes;
var
  K, L, C: Integer;
  Src, Text: TStringList;
  Line, Body: string;
begin
  ForceDirectories(G2GeneratedDirectory);
  { scripts/g2/build.sh wrote the version include here, ahead of the one build.pas writes into source/units }
  DeleteFile(G2GeneratedDirectory + DirectorySeparator + 'Goccia.Version.Generated.inc');
  for K := 0 to High(G2_PRELUDES) do
  begin
    Src := TStringList.Create;
    try
      Src.LoadFromFile('source/g2/prelude/' + G2_PRELUDES[K, 0]);
      while (Src.Count > 0) and (Src[Src.Count - 1] = '') do
        Src.Delete(Src.Count - 1);
      Body := '';
      for L := 0 to Src.Count - 1 do
      begin
        Line := Src[L];
        for C := 1 to Length(Line) do
          if Ord(Line[C]) > 127 then
          begin
            WriteLn('Non-ASCII character in prelude ', G2_PRELUDES[K, 0], ' line ', L + 1);
            Halt(1);
          end;
        if L > 0 then
          Body := Body + ' +' + LineEnding;
        Body := Body + '    ''' + StringReplace(Line, '''', '''''', [rfReplaceAll]) + '''#10';
      end;
      Text := TStringList.Create;
      try
        Text.Add('{ generated by build.pas from ' + G2_PRELUDES[K, 0] + ' }');
        Text.Add('const');
        Text.Add('  ' + G2_PRELUDES[K, 2] + ' =');
        Text.Add(Body + ';');
        WriteIfChanged(G2GeneratedDirectory + DirectorySeparator + G2_PRELUDES[K, 1], Text.Text);
      finally
        Text.Free;
      end;
    finally
      Src.Free;
    end;
  end;
end;

{ Each G2 program's own prelude snapshot: a program that installs the host's preludes (the apps) compiles more of
  them than the bare engine (g2), so they cannot share one }
function G2SnapshotDirectory(const ATarget: string): string;
begin
  Result := 'build' + DirectorySeparator + 'g2' + DirectorySeparator + 'snapshot-' + ATarget;
end;

{ an empty snapshot until the program has made one }
procedure EnsureG2Snapshot(const ATarget: string);
begin
  ForceDirectories(G2SnapshotDirectory(ATarget));
  if not FileExists(G2SnapshotDirectory(ATarget) + DirectorySeparator + 'G2.PreludeSnapshot.inc') then
    WriteIfChanged(G2SnapshotDirectory(ATarget) + DirectorySeparator + 'G2.PreludeSnapshot.inc',
      'const' + LineEnding + '  G2PreludeSnapshotSize = 0;' + LineEnding +
      '  G2PreludeSnapshot: array[0..0] of Byte = (0);' + LineEnding);
end;

{ The compiler arguments of a G2 program. G2 always compiles optimized: its code
  is not written for the dev build's range, overflow and assertion checks. A
  dev build keeps line information instead of stripping it. }
{ FPC_TARGET_CPU and FPC_TARGET_OS name another platform than the one build.pas runs on: a G2 program is then
  built for the host first, to make its prelude snapshot (which does not depend on the platform), then for the
  target with it }
function G2CrossBuild: Boolean;
var
  Cpu, OS: string;
begin
  Cpu := LowerCase(GetEnvironmentVariable('FPC_TARGET_CPU'));
  OS := LowerCase(GetEnvironmentVariable('FPC_TARGET_OS'));
  Result := ((Cpu <> '') and (Cpu <> LowerCase({$I %FPCTARGETCPU%}))) or
    ((OS <> '') and (OS <> LowerCase({$I %FPCTARGETOS%})));
end;

{ AOutput with .exe when the build (the host's when AHost) makes a Windows executable }
function G2Executable(const AOutput: string; AHost: Boolean): string;
var
  OS: string;
begin
  OS := LowerCase(GetEnvironmentVariable('FPC_TARGET_OS'));
  if AHost or (OS = '') then
    OS := LowerCase({$I %FPCTARGETOS%});
  Result := AOutput;
  if ((OS = 'win32') or (OS = 'win64')) and (ExtractFileExt(Result) = '') then
    Result := Result + '.exe';
end;

{ AHost: the host build of a cross build (no target options, no G2_FPC_FLAGS) }
function G2Args(const ASource, AUnitDirectory, AOutput, ATarget: string; AHost: Boolean = False): TStringArray;
var
  Args: TStringList;
  Extra, Word, Cpu: string;
  J: Integer;
begin
  Args := TStringList.Create;
  try
    if not AHost then
    begin
      if GetEnvironmentVariable('FPC_TARGET_CPU') <> '' then
        Args.Add('-P' + GetEnvironmentVariable('FPC_TARGET_CPU'));
      if GetEnvironmentVariable('FPC_TARGET_OS') <> '' then
        Args.Add('-T' + GetEnvironmentVariable('FPC_TARGET_OS'));
      { the target's library options (CI's link libraries and SDK paths), space-separated }
      Extra := GetEnvironmentVariable('G2_FPC_FLAGS') + ' ';
      Word := '';
      for J := 1 to Length(Extra) do
        if Extra[J] = ' ' then
        begin
          if Word <> '' then
            Args.Add(Word);
          Word := '';
        end
        else
          Word := Word + Extra[J];
    end;
    { i386 (win32): -O1. FPC 3.3.1's -O3 and -O4 address an inlined field read through a register they never
      loaded in G2.VM's iterator step (an access violation on every typed array iteration), and with -O2 a
      describe.each inside a describe throws a TypeError that -O1 does not (the miscompile not yet isolated) }
    Cpu := LowerCase(GetEnvironmentVariable('FPC_TARGET_CPU'));
    if AHost or (Cpu = '') then
      Cpu := LowerCase({$I %FPCTARGETCPU%});
    if Cpu = 'i386' then
      Args.Add('-O1')
    else
      Args.Add('-O4');
    Args.Add('-OoNOFASTMATH');
    Args.Add('-dPRODUCTION');
    if BuildMode = bmProd then
      Args.Add('-Xs')
    else
      Args.Add('-gl');
    Args.Add('-Fusource/g2');
    Args.Add('-Fusource/units');
    Args.Add('-Fusource/shared');
    Args.Add('-Fusource/generated');
    Args.Add('-Fusource/app');
    Args.Add('-Fi' + G2SnapshotDirectory(ATarget));
    Args.Add('-Fi' + G2GeneratedDirectory);
    Args.Add('-Fisource/g2');
    Args.Add('-Fisource/units');
    Args.Add('-Fisource/shared');
    Args.Add('-Fisource/generated');
    Args.Add('-Fisource/app');
    Args.Add('-Fisource');
    Args.Add('-FU' + AUnitDirectory);
    Args.Add('-o' + AOutput);
    Args.Add('-vw-n-h-i-l-d-u-t-p-c-x-');
    Args.Add(ASource);
    SetLength(Result, Args.Count);
    for J := 0 to Args.Count - 1 do
      Result[J] := Args[J];
  finally
    Args.Free;
  end;
end;

{ Copies the compiled resources the units link (source/generated/*.res) into AUnitDirectory }
procedure CopyG2Resources(const AUnitDirectory: string);
var
  Res: TStringList;
  Source, Target: TFileStream;
  K: Integer;
begin
  EnsureUnitOutputDirectory(AUnitDirectory);
  Res := TStringList.Create;
  try
    AddFoundFiles(Res, 'source' + DirectorySeparator + 'generated', '.res');
    for K := 0 to Res.Count - 1 do
      if not FileExists(AUnitDirectory + DirectorySeparator + ExtractFileName(Res[K])) then
      begin
        Source := TFileStream.Create(Res[K], fmOpenRead or fmShareDenyWrite);
        try
          Target := TFileStream.Create(AUnitDirectory + DirectorySeparator + ExtractFileName(Res[K]), fmCreate);
          try
            Target.CopyFrom(Source, 0);
          finally
            Target.Free;
          end;
        finally
          Source.Free;
        end;
      end;
  finally
    Res.Free;
  end;
end;

{ As CompileWithStaleRetry, with G2's arguments }
function CompileG2Program(const ASource, AUnitDirectory, AOutput, ALabel: string;
  out AOutputText: string; AHost: Boolean = False): Boolean;
begin
  CopyG2Resources(AUnitDirectory);
  Result := CompileProgram(G2Args(ASource, AUnitDirectory, AOutput, ALabel, AHost), AOutputText);
  if Result or not HasStaleArtifactSignature(AOutputText) then
    Exit;
  WriteLn('FPC reported a stale-state error for ', ALabel, '; retrying once from a clean unit directory. The first attempt:');
  { what the first attempt said: a retry that fails as well shows only its own output }
  WriteLn(AOutputText);
  RemoveCompiledArtifacts(AUnitDirectory);
  CopyG2Resources(AUnitDirectory);
  Result := CompileProgram(G2Args(ASource, AUnitDirectory, AOutput, ALabel, AHost), AOutputText);
end;

{ Runs the stage-1 engine to snapshot its compiled preludes (G2.Snapshot) into G2.PreludeSnapshot.inc; True when
  the snapshot changed, so the engine is compiled again with it }
function SnapshotG2Preludes(const AExecutable, ATarget: string): Boolean;
var
  Proc: TProcess;
  Snap, Empty: string;
  F: TFileStream;
  Bytes: array of Byte;
  Text: TStringBuilder;
  K: Integer;
begin
  Snap := 'build' + DirectorySeparator + 'g2' + DirectorySeparator + 'snap.bin';
  Empty := 'build' + DirectorySeparator + 'g2' + DirectorySeparator + 'snap-empty.js';
  WriteIfChanged(Empty, 'const x = 0;' + LineEnding);
  { the benchmark runner fails a file without benchmarks: its run measures one, as briefly as the settings allow }
  if ATarget = 'g2benchrunner' then
  begin
    Empty := 'build' + DirectorySeparator + 'g2' + DirectorySeparator + 'snap-bench.js';
    WriteIfChanged(Empty, 'import { bench } from "goccia:microbench";' + LineEnding +
      'bench("snapshot", () => 0);' + LineEnding);
  end;
  Proc := TProcess.Create(nil);
  try
    Proc.Executable := AExecutable;
    Proc.Parameters.Add(Empty);
    for K := 0 to GetEnvironmentVariableCount - 1 do
      Proc.Environment.Add(GetEnvironmentString(K));
    Proc.Environment.Add('G2_SNAPSHOT_OUT=' + Snap);
    if ATarget = 'g2benchrunner' then
    begin
      Proc.Parameters.Add('--no-progress');
      Proc.Environment.Add('GOCCIA_BENCH_WARMUP=1');
      Proc.Environment.Add('GOCCIA_BENCH_CALIBRATION_MS=1');
      Proc.Environment.Add('GOCCIA_BENCH_ROUNDS=1');
    end;
    Proc.Environment.Add('G2_NO_SNAPSHOT=1');
    Proc.Options := [poWaitOnExit];
    Proc.Execute;
    if Proc.ExitStatus <> 0 then
    begin
      WriteLn('The G2 prelude snapshot run failed (exit ', Proc.ExitStatus, ')');
      Halt(1);
    end;
  finally
    Proc.Free;
  end;
  F := TFileStream.Create(Snap, fmOpenRead);
  try
    SetLength(Bytes, F.Size);
    if F.Size > 0 then
      F.ReadBuffer(Bytes[0], F.Size);
  finally
    F.Free;
  end;
  Text := TStringBuilder.Create;
  try
    Text.Append('{ generated by build.pas from G2_SNAPSHOT_OUT: compiled JS preludes (see G2.Snapshot) }' + LineEnding);
    Text.Append('const' + LineEnding);
    Text.Append('  G2PreludeSnapshotSize = ' + IntToStr(Length(Bytes)) + ';' + LineEnding);
    Text.Append('  G2PreludeSnapshot: array[0..' + IntToStr(Length(Bytes) - 1) + '] of Byte = (' + LineEnding + '    ');
    for K := 0 to High(Bytes) do
    begin
      if K > 0 then
      begin
        Text.Append(',');
        if K mod 32 = 0 then
          Text.Append(LineEnding + '    ');
      end;
      Text.Append(IntToStr(Bytes[K]));
    end;
    Text.Append(');' + LineEnding);
    Result := WriteIfChanged(G2SnapshotDirectory(ATarget) + DirectorySeparator + 'G2.PreludeSnapshot.inc',
      Text.ToString);
  finally
    Text.Free;
  end;
end;

{ Linux x86-64: the native-TLS relocation check (scripts/g2/tlsscan.py), when python3 and binutils are there }
procedure CheckG2ThreadVarRelocations(const AUnitDirectory: string);
var
  Objects: TStringList;
  Args: array of string;
  Output: string;
  K: Integer;
begin
  {$IF defined(LINUX) and defined(CPUX86_64)}
  Objects := TStringList.Create;
  try
    AddFoundFiles(Objects, AUnitDirectory, '.o');
    SetLength(Args, Objects.Count + 1);
    Args[0] := 'scripts/g2/tlsscan.py';
    for K := 0 to Objects.Count - 1 do
      Args[K + 1] := Objects[K];
    if not RunCommand('python3', Args, Output) then
    begin
      WriteLn('Skipping the threadvar relocation check: python3 or binutils is missing');
      Exit;
    end;
    if Pos('total 0' + LineEnding, Output) <> 0 then
      WriteLn('Threadvar relocations: none broken')
    else
    begin
      WriteLn('Broken threadvar relocations:');
      WriteLn(Output);
      Halt(1);
    end;
  finally
    Objects.Free;
  end;
  {$ENDIF}
end;

{ Builds ASource as a G2 program: the preludes generated, stage 1 compiled, its compiled preludes snapshot, and
  the program compiled again when the snapshot changed. A cross build (G2CrossBuild) makes the snapshot with a
  host build of the program (build/g2/host), then compiles the target once with it. }
procedure BuildG2Program(const ASource, ATarget, AOutput: string);
var
  UnitDir, Output, HostOutput, TargetOutput: string;
begin
  WriteLn('');
  WriteLn('Building ', AOutput, ' (G2)...');
  GenerateG2Preludes;
  EnsureG2Snapshot(ATarget);
  { its own unit cache per mode: G2 builds incrementally (no -B), and FPC does not recompile a unit for new options }
  UnitDir := TargetUnitOutputDirectory(ATarget);
  if BuildMode <> bmProd then
    UnitDir := UnitDir + '-dev';
  if G2CrossBuild then
  begin
    ForceDirectories('build' + DirectorySeparator + 'g2' + DirectorySeparator + 'host');
    HostOutput := G2Executable('build' + DirectorySeparator + 'g2' + DirectorySeparator + 'host' +
      DirectorySeparator + ExtractFileName(AOutput), True);
    if not CompileG2Program(ASource, UnitDir + '-host', HostOutput, ATarget, Output, True) then
      PrintBuildFailureAndExit(Output, HostOutput + ' build failed');
    SnapshotG2Preludes(HostOutput, ATarget);
    { the target's own unit cache: units compiled for another platform }
    UnitDir := UnitDir + '-' + LowerCase(GetEnvironmentVariable('FPC_TARGET_CPU')) + '-' +
      LowerCase(GetEnvironmentVariable('FPC_TARGET_OS'));
    TargetOutput := G2Executable(AOutput, False);
    if not CompileG2Program(ASource, UnitDir, TargetOutput, ATarget, Output) then
      PrintBuildFailureAndExit(Output, TargetOutput + ' build failed');
    WriteLn(TargetOutput, ' built successfully');
    Exit;
  end;
  if not CompileG2Program(ASource, UnitDir, AOutput, ATarget, Output) then
    PrintBuildFailureAndExit(Output, AOutput + ' build failed');
  CheckG2ThreadVarRelocations(UnitDir);
  if SnapshotG2Preludes(AOutput, ATarget) then
  begin
    WriteLn('Prelude snapshot changed: compiling again with it');
    DeleteFile(UnitDir + DirectorySeparator + 'G2.Snapshot.ppu');
    DeleteFile(UnitDir + DirectorySeparator + 'G2.Snapshot.o');
    if not CompileG2Program(ASource, UnitDir, AOutput, ATarget, Output) then
      PrintBuildFailureAndExit(Output, AOutput + ' build failed');
    CheckG2ThreadVarRelocations(UnitDir);
  end;
  WriteLn(AOutput, ' built successfully');
end;

{ native-TLS threadvars and the code generator fixes G2 needs are in fpc-toolchain's 3.3.1 builds }
procedure CheckG2Compiler;
var
  Version: string;
begin
  if not RunCommand('fpc', ['-iV'], Version) or (CompareStr(Trim(Version), '3.3.1') < 0) then
  begin
    WriteLn('G2 needs FPC 3.3.1 from fpc-toolchain (build 3.3.1+5 or later; CI uses 3.3.1+7); found ', Trim(Version));
    WriteLn('Select it with: eval "$(fpc-toolchain env 3.3.1+7)"');
    Halt(1);
  end;
end;

