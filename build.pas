function ComputeVersion: string;
var
  Describe: string;
  DashPos: SizeInt;
begin
  if not RunCommand('git', ['describe', '--tags', '--always', '--match', '[0-9]*'], Describe, [poRunIdle]) then
    Describe := '';
  Describe := Trim(Describe);

  if (Describe = '') or (Pos('.', Describe) = 0) then
    Result := '0.0.0-dev'
  else
  begin
    DashPos := Pos('-', Describe);
    if DashPos > 0 then
      Result := Copy(Describe, 1, DashPos - 1) + '-dev'
    else
      Result := Describe;
  end;
end;

function ComputeCommit: string;
begin
  if not RunCommand('git', ['rev-parse', '--short', 'HEAD'], Result, [poRunIdle]) then
    Result := '';
  Result := Trim(Result);
  if Result = '' then
    Result := 'unknown';
end;

function ComputeBuildDate: string;
begin
  Result := FormatDateTime('yyyy-mm-dd', Now);
end;

procedure GenerateVersionInclude(const AVersion, ACommit, ABuildDate: string);
var
  F: TextFile;
begin
  AssignFile(F, 'source' + DirectorySeparator + 'units' + DirectorySeparator + 'Goccia.Version.Generated.inc');
  Rewrite(F);
  try
    WriteLn(F, '// Auto-generated by build.pas — do not edit');
    WriteLn(F, 'const');
    WriteLn(F, '  BAKED_VERSION = ''', AVersion, ''';');
    WriteLn(F, '  BAKED_COMMIT = ''', ACommit, ''';');
    WriteLn(F, '  BAKED_BUILD_DATE = ''', ABuildDate, ''';');
  finally
    CloseFile(F);
  end;
end;

procedure PrintVersion(const AVersion, ACommit, ABuildDate: string);
begin
  WriteLn('Version: ', AVersion, ' (', ACommit, ') built ', ABuildDate);
  WriteLn('');
end;

procedure StripBlockComments(var AText: string; var AInBlock: Boolean);
var
  OpenPos, ClosePos: SizeInt;
  Sub: string;
begin
  repeat
    if AInBlock then
    begin
      ClosePos := Pos('}', AText);
      if ClosePos = 0 then
        ClosePos := Pos('*)', AText);
      if ClosePos > 0 then
      begin
        if AText[ClosePos] = '*' then
          Delete(AText, 1, ClosePos + 1)
        else
          Delete(AText, 1, ClosePos);
        AText := Trim(AText);
        AInBlock := False;
      end
      else
      begin
        AText := '';
        Exit;
      end;
    end
    else
    begin
      OpenPos := Pos('{', AText);
      if (OpenPos > 0) and (Copy(AText, OpenPos, 2) <> '{$') then
      begin
        Sub := Copy(AText, OpenPos + 1, Length(AText));
        ClosePos := Pos('}', Sub);
        if ClosePos > 0 then
        begin
          Delete(AText, OpenPos, ClosePos + 1);
          AText := Trim(AText);
        end
        else
        begin
          Delete(AText, OpenPos, Length(AText));
          AText := Trim(AText);
          AInBlock := True;
          Exit;
        end;
        Continue;
      end;

      OpenPos := Pos('(*', AText);
      if OpenPos > 0 then
      begin
        Sub := Copy(AText, OpenPos + 2, Length(AText));
        ClosePos := Pos('*)', Sub);
        if ClosePos > 0 then
        begin
          Delete(AText, OpenPos, ClosePos + 3);
          AText := Trim(AText);
        end
        else
        begin
          Delete(AText, OpenPos, Length(AText));
          AText := Trim(AText);
          AInBlock := True;
          Exit;
        end;
        Continue;
      end;

      Exit;
    end;
  until AText = '';
end;

procedure CountLines(const AFileName: string; out ALOC, ASLOC: Integer);
var
  F: TextFile;
  Line, Trimmed: string;
  InBlock: Boolean;
begin
  ALOC := 0;
  ASLOC := 0;
  InBlock := False;

  AssignFile(F, AFileName);
  Reset(F);
  try
    while not EOF(F) do
    begin
      ReadLn(F, Line);
      Inc(ALOC);
      Trimmed := Trim(Line);

      StripBlockComments(Trimmed, InBlock);

      if Trimmed = '' then
        Continue;
      if Copy(Trimmed, 1, 2) = '//' then
        Continue;

      Inc(ASLOC);
    end;
  finally
    CloseFile(F);
  end;
end;

function FormatNumber(const AValue: Integer): string;
var
  S: string;
  Len, InsertPos: Integer;
begin
  S := IntToStr(AValue);
  Len := Length(S);
  InsertPos := Len - 3;
  while InsertPos > 0 do
  begin
    Insert(',', S, InsertPos + 1);
    Dec(InsertPos, 3);
  end;
  Result := S;
end;

{ FindAllFiles returns a list the caller owns (#1592). }
procedure AddFoundFiles(const AFiles: TStringList; const ADirectory,
  AExtension: string);
var
  Found: TStringList;
begin
  Found := FindAllFiles(ADirectory, AExtension);
  try
    AFiles.AddStrings(Found);
  finally
    Found.Free;
  end;
end;

procedure PrintSourceStats;
var
  Files: TStringList;
  K, FileLOC, FileSLOC, TotalLOC, TotalSLOC: Integer;
begin
  TotalLOC := 0;
  TotalSLOC := 0;

  Files := TStringList.Create;
  try
    AddFoundFiles(Files, 'source/units', '.pas');
    AddFoundFiles(Files, 'source/shared', '.pas');
    AddFoundFiles(Files, 'source/app', '.pas');
    AddFoundFiles(Files, 'source/app', '.dpr');
    AddFoundFiles(Files, 'source/units', '.inc');

    for K := 0 to Files.Count - 1 do
    begin
      CountLines(Files[K], FileLOC, FileSLOC);
      TotalLOC := TotalLOC + FileLOC;
      TotalSLOC := TotalSLOC + FileSLOC;
    end;

    WriteLn('Source: ', FormatNumber(TotalLOC), ' LOC | ', FormatNumber(TotalSLOC), ' SLOC (', Files.Count, ' files)');
    WriteLn('');
  finally
    Files.Free;
  end;
end;

function GCStressExecutableDirectory: string;
begin
  Result := 'build' + DirectorySeparator + 'gc-stress';
end;

{ Root of the unit caches. The GC-stress build keeps its own, because FPC does
  not recompile a unit when only the defines change: a shared cache would hand
  stress-compiled units to an ordinary build, or the reverse. }
function CompiledRootDirectory: string;
begin
  Result := 'build' + DirectorySeparator + 'compiled';
  if GCStressBuild then
    Result := Result + DirectorySeparator + 'gc-stress';
end;

function FPCArgs(const ASource: string;
  const AUnitOutputDirectory: string = ''): TStringArray;
var
  Arch: string;
  Args: TStringList;
  J: Integer;
begin
  Args := TStringList.Create;
  try
    Arch := GetEnvironmentVariable('FPC_TARGET_CPU');
    if Arch <> '' then
      Args.Add('-P' + Arch);

    Args.Add('@config.cfg');
    if AUnitOutputDirectory <> '' then
      Args.Add('-FU' + AUnitOutputDirectory);

    if BuildMode = bmProd then
    begin
      // -O4 for aggressive optimization. The one -O4 optimization that is
      // unsafe for this engine, FASTMATH, is force-disabled at the source level
      // in Shared.inc ({$OPTIMIZATION NOFASTMATH}) because it violates the
      // IEEE-754 double semantics JavaScript requires (it miscompiled the
      // edge-case Temporal hoursInDay DST math — PR #797). Keeping the guard in
      // source rather than here makes it a compiler-enforced invariant that
      // travels with the code regardless of how fpc is invoked.
      Args.Add('-O4');
      Args.Add('-dPRODUCTION');
      Args.Add('-Xs');
      Args.Add('-CX');
      Args.Add('-XX');
      Args.Add('-B');
    end else
    begin
      Args.Add('-O-');
      Args.Add('-gw');
      Args.Add('-godwarfsets');
      Args.Add('-gl');
      Args.Add('-Ct');
      Args.Add('-Cr');
      Args.Add('-Sa');
      if GCStressBuild then
      begin
        Args.Add('-gh');
        Args.Add('-dGOCCIA_GC_STRESS');
        Args.Add('-FE' + GCStressExecutableDirectory);
      end;
    end;

    Args.Add('-vw-n-h-i-l-d-u-t-p-c-x-');
    Args.Add(ASource);

    SetLength(Result, Args.Count);
    for J := 0 to Args.Count - 1 do
      Result[J] := Args[J];
  finally
    Args.Free;
  end;
end;

function TestUnitOutputDirectory(const ATestFile: string): string;
var
  RelativePath, SafePath: string;
begin
  RelativePath := ChangeFileExt(ATestFile, '');
  SafePath := StringReplace(RelativePath, '/', DirectorySeparator, [rfReplaceAll]);
  SafePath := StringReplace(SafePath, '\', DirectorySeparator, [rfReplaceAll]);
  Result := CompiledRootDirectory + DirectorySeparator +
    'tests' + DirectorySeparator + SafePath;
end;

function TargetUnitOutputDirectory(const ATarget: string): string;
begin
  Result := CompiledRootDirectory + DirectorySeparator +
    'targets' + DirectorySeparator + ATarget;
end;

function EnsureUnitOutputDirectory(const ADirectory: string): string;
begin
  if not DirectoryExists(ADirectory) then
    ForceDirectories(ADirectory);
  Result := ADirectory;
end;

function HasStaleArtifactSignature(const AOutput: string): Boolean;
var
  LowerOutput: string;
begin
  LowerOutput := LowerCase(AOutput);
  Result :=
    (Pos('internal error', LowerOutput) > 0) or
    (Pos('compilation raised exception internally', LowerOutput) > 0) or
    (Pos('error while compiling resources', LowerOutput) > 0) or
    ((Pos('.reslst', LowerOutput) > 0) and
     ((Pos('cannot open', LowerOutput) > 0) or
      (Pos('not found', LowerOutput) > 0) or
      (Pos('no such file', LowerOutput) > 0)));
end;

{ Deletes the compiled state FPC leaves under ADirectory (units, objects,
  resources) and returns how many files it removed. Both scoped --clean and
  the stale-state retry pass one target or test program's unit directory. }
function RemoveCompiledArtifacts(const ADirectory: string): Integer;
var
  Files: TStringList;
  K: Integer;
begin
  Files := TStringList.Create;
  try
    AddFoundFiles(Files, ADirectory, '.ppu');
    AddFoundFiles(Files, ADirectory, '.o');
    AddFoundFiles(Files, ADirectory, '.or');
    AddFoundFiles(Files, ADirectory, '.res');
    AddFoundFiles(Files, ADirectory, '.reslst');

    for K := 0 to Files.Count - 1 do
      DeleteFile(Files[K]);

    Result := Files.Count;
  finally
    Files.Free;
  end;
end;

{ Runs fpc for ASource into AUnitOutputDirectory. When it fails with a
  stale-compiled-state symptom, wipes that one unit directory and runs the
  compile once more, as --clean would for it. A failure without such a symptom
  (an ordinary compile error) is returned as is, and the retry is never
  repeated: AOutput holds the output of the last run. ALabel names the thing
  being built in the message. }
function CompileWithStaleRetry(const ASource, AUnitOutputDirectory,
  ALabel: string; out AOutput: string): Boolean;
begin
  Result := RunCommand('fpc', FPCArgs(ASource,
    EnsureUnitOutputDirectory(AUnitOutputDirectory)), AOutput, [poRunIdle]);
  if Result or not HasStaleArtifactSignature(AOutput) then
    Exit;

  WriteLn('FPC reported a stale-state error for ', ALabel,
    '; retrying once from a clean unit directory');
  RemoveCompiledArtifacts(AUnitOutputDirectory);
  Result := RunCommand('fpc', FPCArgs(ASource,
    EnsureUnitOutputDirectory(AUnitOutputDirectory)), AOutput, [poRunIdle]);
end;

procedure PrintBuildFailureAndExit(const AOutput, AFailureMessage: string);
begin
  WriteLn(AOutput);
  if HasStaleArtifactSignature(AOutput) then
  begin
    WriteLn('');
    WriteLn('Hint: this looked like stale FPC build state, but the build ' +
      'already retried once from a clean unit directory and failed again.');
    WriteLn('Diagnose the reported source line.');
    WriteLn('');
  end;
  WriteLn(AFailureMessage);
  Halt(1);
end;

