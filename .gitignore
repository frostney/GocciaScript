# Output files
*.o
*.or
*.ppu
*.rsj

# Generated files
source/units/Goccia.Version.Generated.inc
tmp/

# Build files
build/

# Delphi IDE state and generated project resources
source/app/*.dproj.local
source/app/*.res
source/app/__history/

# Mac OS files
.DS_Store

# Node modules
node_modules/

# Except the hand-written node_modules fixtures the bare-specifier suites
# resolve against. They are source, not installs: no package manager ever writes
# to them, and the differential one is deliberately kept away from the
# npm-managed scripts/differential/node_modules so `bun install` cannot prune it.
!scripts/differential/mods/nodemods/node_modules/
!tests/language/modules/node-modules/node_modules/

scripts/__pycache__/

tests-wasm/*.wasm

# FFI fixture binaries (built from source by fixtures/ffi/build.sh)
fixtures/ffi/*.dylib
fixtures/ffi/*.so
fixtures/ffi/*.dll
fixtures/ffi/*.lib
fixtures/ffi/*.pdb

# Claude Code agent runtime state
.claude/scheduled_tasks.lock
.claude/worktrees/

# check-conformance-claims.ts --self-test symlink fixtures. Removed in a
# `finally`, but a SIGKILL mid-run would otherwise leave untracked litter.
.conformance-selftest-*/
