{
  "$comment": "Shared test vectors for sandbox filesystem search: fs.globSync, and grep and fuzzyFind from goccia:search. Each case names a tree; a file is a UTF-8 string or { base64 } bytes, and directories are the files' parents. glob results are relative to the cwd (absolute for an absolute pattern); fuzzyFind and grep return absolute paths. See docs/built-ins-sandbox-search.md.",
  "version": 1,
  "trees": {
    "project": {
      "/README.md": "# Demo\n\nTODO: write the guide.\nSee docs/guide.md.\n",
      "/package.json": "{\n  \"name\": \"demo\",\n  \"type\": \"module\"\n}\n",
      "/.env": "TOKEN=placeholder\n",
      "/.github/workflows/ci.yml": "name: ci\non: [push]\n",
      "/docs/guide.md": "# Guide\n\nImport the controller:\n\n    import { controller } from \"../src/user/controller.ts\";\n",
      "/docs/api/index.md": "# API\n\nexport surface\n",
      "/src/index.ts": "import { App } from \"./app.tsx\";\nimport { controller } from \"./user/controller.ts\";\n\nexport const main = () => App(controller);\n",
      "/src/app.tsx": "export function App(props) {\n  // todo: render\n  return props;\n}\n",
      "/src/user/controller.ts": "import { model } from \"./model.ts\";\n\nexport const controller = {\n  find(id) { return model.get(id); },\n  // TODO: paginate\n  list() { return model.all(); },\n};\n",
      "/src/user/model.ts": "const rows = new Map();\nexport const model = {\n  get: (id) => rows.get(id),\n  all: () => [...rows.values()],\n};\n",
      "/src/user/controller.test.ts": "import { controller } from \"./controller.ts\";\n\ntest(\"finds\", () => {\n  expect(controller.find(1)).toBeUndefined();\n});\n",
      "/src/util/strings.ts": "export const pad = (s, n) => s.padStart(n);\r\nexport const trim = (s) => s.trim();\r\n",
      "/src/util/.cache/stale.ts": "export const stale = true;\n",
      "/src/components/Button.tsx": "export const Button = () => \"button\";\n",
      "/src/components/ButtonGroup.tsx": "import { Button } from \"./Button.tsx\";\nexport const ButtonGroup = () => [Button(), Button()];\n",
      "/lib/weird[1].js": "a.b(c) and a+b(c)\n",
      "/lib/bundle.min.js": "var x=1;export{x};var y=2;export{y}",
      "/assets/logo.png": {
        "base64": "wolQTkcNChoKAABleHBvcnQgVE9ETwA="
      },
      "/assets/latin1.txt": {
        "base64": "Y2Fm6SBUT0RPCg=="
      },
      "/notes/ünïcode.md": "ünïcode needle here\n😀 needle after an emoji\n﻿not a BOM in the middle\n",
      "/notes/bom.txt": "﻿needle at the start\nsecond line\n",
      "/notes/empty-lines.txt": "first\n\n\nlast without newline",
      "/notes/repeat.txt": "aa bb aa\nabab\nxyzzy\n",
      "/notes/😀-smile.md": "smile\n"
    }
  },
  "glob": [
    {
      "name": "every TypeScript file below the cwd",
      "tree": "project",
      "pattern": "**/*.ts",
      "expect": [
        "src/index.ts",
        "src/user/controller.test.ts",
        "src/user/controller.ts",
        "src/user/model.ts",
        "src/util/strings.ts"
      ]
    },
    {
      "name": "one level, files and directories, no dot entries",
      "tree": "project",
      "pattern": "src/*",
      "expect": [
        "src/app.tsx",
        "src/components",
        "src/index.ts",
        "src/user",
        "src/util"
      ]
    },
    {
      "name": "globstar alone lists every entry that is not hidden, the cwd itself excluded",
      "tree": "project",
      "pattern": "**",
      "expect": [
        "README.md",
        "assets",
        "assets/latin1.txt",
        "assets/logo.png",
        "docs",
        "docs/api",
        "docs/api/index.md",
        "docs/guide.md",
        "lib",
        "lib/bundle.min.js",
        "lib/weird[1].js",
        "notes",
        "notes/bom.txt",
        "notes/empty-lines.txt",
        "notes/repeat.txt",
        "notes/ünïcode.md",
        "notes/😀-smile.md",
        "package.json",
        "src",
        "src/app.tsx",
        "src/components",
        "src/components/Button.tsx",
        "src/components/ButtonGroup.tsx",
        "src/index.ts",
        "src/user",
        "src/user/controller.test.ts",
        "src/user/controller.ts",
        "src/user/model.ts",
        "src/util",
        "src/util/strings.ts"
      ]
    },
    {
      "name": "a dot entry needs a pattern segment that starts with a literal dot",
      "tree": "project",
      "pattern": "**/.*",
      "expect": [
        ".env",
        ".github",
        "src/util/.cache"
      ]
    },
    {
      "name": "a globstar does not descend into a hidden directory",
      "tree": "project",
      "pattern": "src/util/**",
      "expect": [
        "src/util",
        "src/util/strings.ts"
      ]
    },
    {
      "name": "an explicit hidden directory is searched",
      "tree": "project",
      "pattern": "src/util/.*/*",
      "expect": [
        "src/util/.cache/stale.ts"
      ]
    },
    {
      "name": "a hidden directory named in full",
      "tree": "project",
      "pattern": ".github/**",
      "expect": [
        ".github",
        ".github/workflows",
        ".github/workflows/ci.yml"
      ]
    },
    {
      "name": "brace alternatives",
      "tree": "project",
      "pattern": "src/**/*.{ts,tsx}",
      "expect": [
        "src/app.tsx",
        "src/components/Button.tsx",
        "src/components/ButtonGroup.tsx",
        "src/index.ts",
        "src/user/controller.test.ts",
        "src/user/controller.ts",
        "src/user/model.ts",
        "src/util/strings.ts"
      ]
    },
    {
      "name": "nested braces",
      "tree": "project",
      "pattern": "src/{user/{model,controller},util/strings}.ts",
      "expect": [
        "src/user/controller.ts",
        "src/user/model.ts",
        "src/util/strings.ts"
      ]
    },
    {
      "name": "an empty brace alternative",
      "tree": "project",
      "pattern": "{,docs/}*.md",
      "expect": [
        "README.md",
        "docs/guide.md"
      ]
    },
    {
      "name": "a brace with no comma is literal",
      "tree": "project",
      "pattern": "src/{index}.ts",
      "expect": []
    },
    {
      "name": "braces over directories",
      "tree": "project",
      "pattern": "{docs,lib}/**",
      "expect": [
        "docs",
        "docs/api",
        "docs/api/index.md",
        "docs/guide.md",
        "lib",
        "lib/bundle.min.js",
        "lib/weird[1].js"
      ]
    },
    {
      "name": "question mark matches one character, a dot included",
      "tree": "project",
      "pattern": "src/user/controller?ts",
      "expect": [
        "src/user/controller.ts"
      ]
    },
    {
      "name": "a character class with a range",
      "tree": "project",
      "pattern": "src/components/[A-Z]*.tsx",
      "expect": [
        "src/components/Button.tsx",
        "src/components/ButtonGroup.tsx"
      ]
    },
    {
      "name": "a negated character class",
      "tree": "project",
      "pattern": "src/components/[!B]*",
      "expect": []
    },
    {
      "name": "a negated class with a caret",
      "tree": "project",
      "pattern": "src/user/[^c]*",
      "expect": [
        "src/user/model.ts"
      ]
    },
    {
      "name": "a class matching a literal bracket",
      "tree": "project",
      "pattern": "lib/weird[[]1].js",
      "expect": [
        "lib/weird[1].js"
      ]
    },
    {
      "name": "a trailing slash matches directories only",
      "tree": "project",
      "pattern": "**/",
      "expect": [
        "assets",
        "docs",
        "docs/api",
        "lib",
        "notes",
        "src",
        "src/components",
        "src/user",
        "src/util"
      ]
    },
    {
      "name": "a named directory with a trailing slash",
      "tree": "project",
      "pattern": "docs/api/",
      "expect": [
        "docs/api"
      ]
    },
    {
      "name": "a file with a trailing slash matches nothing",
      "tree": "project",
      "pattern": "src/user/controller.ts/",
      "expect": []
    },
    {
      "name": "matching is case-sensitive",
      "tree": "project",
      "pattern": "**/*.MD",
      "expect": []
    },
    {
      "name": "no match is an empty array",
      "tree": "project",
      "pattern": "**/*.rs",
      "expect": []
    },
    {
      "name": "a leading ./ is ignored",
      "tree": "project",
      "pattern": "./src/*.ts",
      "expect": [
        "src/index.ts"
      ]
    },
    {
      "name": "non-ASCII names",
      "tree": "project",
      "pattern": "**/ü*.md",
      "expect": [
        "notes/ünïcode.md"
      ]
    },
    {
      "name": "a question mark matches one UTF-16 code unit, as in Node",
      "tree": "project",
      "pattern": "notes/??-smile.md",
      "expect": [
        "notes/😀-smile.md"
      ]
    },
    {
      "name": "a character outside the BMP is two code units",
      "tree": "project",
      "pattern": "notes/?-smile.md",
      "expect": []
    },
    {
      "name": "dots inside names are literal",
      "tree": "project",
      "pattern": "**/*.min.js",
      "expect": [
        "lib/bundle.min.js"
      ]
    },
    {
      "name": "several patterns are merged, sorted and deduplicated",
      "tree": "project",
      "pattern": [
        "**/*.md",
        "docs/**/*.md",
        "*.json"
      ],
      "expect": [
        "README.md",
        "docs/api/index.md",
        "docs/guide.md",
        "notes/ünïcode.md",
        "notes/😀-smile.md",
        "package.json"
      ]
    },
    {
      "name": "an absolute pattern returns absolute paths",
      "tree": "project",
      "pattern": "/src/user/*.ts",
      "expect": [
        "/src/user/controller.test.ts",
        "/src/user/controller.ts",
        "/src/user/model.ts"
      ]
    },
    {
      "name": "the cwd option makes results relative to it",
      "tree": "project",
      "pattern": "**/*.ts",
      "options": {
        "cwd": "/src"
      },
      "expect": [
        "index.ts",
        "user/controller.test.ts",
        "user/controller.ts",
        "user/model.ts",
        "util/strings.ts"
      ]
    },
    {
      "name": "an absolute pattern ignores the cwd",
      "tree": "project",
      "pattern": "/docs/*.md",
      "options": {
        "cwd": "/src"
      },
      "expect": [
        "/docs/guide.md"
      ]
    },
    {
      "name": "a cwd that does not exist gives no results",
      "tree": "project",
      "pattern": "**",
      "options": {
        "cwd": "/missing"
      },
      "expect": []
    },
    {
      "name": "exclude removes a directory and everything below it",
      "tree": "project",
      "pattern": "src/**/*.ts",
      "options": {
        "exclude": [
          "src/user"
        ]
      },
      "expect": [
        "src/index.ts",
        "src/util/strings.ts"
      ]
    },
    {
      "name": "exclude patterns follow the same rules",
      "tree": "project",
      "pattern": "**/*.ts",
      "options": {
        "exclude": [
          "**/*.test.ts"
        ]
      },
      "expect": [
        "src/index.ts",
        "src/user/controller.ts",
        "src/user/model.ts",
        "src/util/strings.ts"
      ]
    },
    {
      "name": "an exclude pattern matches from the cwd, not anywhere",
      "tree": "project",
      "pattern": "**/*.ts",
      "options": {
        "exclude": [
          "*.ts"
        ]
      },
      "expect": [
        "src/index.ts",
        "src/user/controller.test.ts",
        "src/user/controller.ts",
        "src/user/model.ts",
        "src/util/strings.ts"
      ]
    },
    {
      "name": "exclude is relative to the cwd",
      "tree": "project",
      "pattern": "**",
      "options": {
        "cwd": "/src",
        "exclude": [
          "user/**",
          "components"
        ]
      },
      "expect": [
        "app.tsx",
        "index.ts",
        "util",
        "util/strings.ts"
      ]
    },
    {
      "name": "a backslash is a path separator",
      "tree": "project",
      "pattern": "src\\user\\*.ts",
      "expect": [
        "src/user/controller.test.ts",
        "src/user/controller.ts",
        "src/user/model.ts"
      ]
    }
  ],
